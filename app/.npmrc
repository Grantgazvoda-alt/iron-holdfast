; Package resolution goes through the Socket firewall (supply-chain inspection).
; bun reads its own bunfig.toml; this file keeps any npm/npx-based tooling on the
; same path, so a stray `npm install` cannot silently skip the firewall.
; The trailing slash matters — without it the `/npm` path is dropped.
registry=https://socket-firewall.higgsfield.xyz/npm/
